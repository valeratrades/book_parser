# Applies to every `nix` invocation made from this directory — `use flake` below,
# but also a plain `nix run`/`nix build` typed later in the loaded shell. `extra-`
# appends, so a host nix.conf that already enables features keeps them.
# accept-flake-config: take the flake's nixConfig (the cachix substituter) without
# prompting, so a fresh machine substitutes instead of building from source.
export NIX_CONFIG="extra-experimental-features = nix-command flakes
accept-flake-config = true"

# nix only drops pure evaluation for flakes on `--impure`, never from config, so every evaluating command gets it
mkdir -p .direnv/bin
cat > .direnv/bin/nix <<EOF
#!/usr/bin/env bash
case "\$1" in
  flake) exec $(command -v nix) "\$1" "\$2" --impure "\${@:3}";;
  build|run|eval|develop|shell|print-dev-env) cmd=\$1; shift; exec $(command -v nix) "\$cmd" --impure "\$@";;
esac
exec $(command -v nix) "\$@"
EOF
chmod +x .direnv/bin/nix
PATH_add .direnv/bin

use flake
